<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/attachment_tile"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/km_attachment_item_background">

        <ImageView
            android:id="@+id/galleryImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/attachment_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:scaleType="centerCrop"
            android:src="@drawable/km_ic_action_attachment"
            android:visibility="gone" />

        <TextView
            android:id="@+id/attachment_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="48dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/km_attachment_caption_text"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom">

            <TextView
                android:id="@+id/attachment_file_size"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/km_attachment_bar_background"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="56dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/attachment_delete_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="@color/km_attachment_delete_background"
                android:contentDescription="@string/cancel_text"
                android:src="@drawable/km_attachment_ic_delete" />
        </FrameLayout>
    </FrameLayout>

    <EditText
        android:id="@+id/attachment_caption_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/km_attachment_caption_background"
        android:hint="@string/Add_caption"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:minHeight="44dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textAlignment="viewStart"
        android:textColor="@color/km_attachment_caption_text"
        android:textColorHint="@color/km_attachment_caption_hint"
        android:textSize="16sp" />
</LinearLayout>
