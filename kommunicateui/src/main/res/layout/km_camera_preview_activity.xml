<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/km_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Step 1: review the captured photo -->
    <LinearLayout
        android:id="@+id/km_preview_review_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/km_preview_review_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="#CC3B3835"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/km_preview_rotate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/km_preview_rotate"
                android:src="@drawable/km_preview_ic_rotate" />

            <ImageButton
                android:id="@+id/km_preview_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/km_preview_confirm"
                android:src="@drawable/km_preview_ic_check" />

            <ImageButton
                android:id="@+id/km_preview_discard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel_text"
                android:src="@drawable/km_preview_ic_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Step 2: add a caption and send -->
    <LinearLayout
        android:id="@+id/km_preview_caption_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121C1A"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/km_preview_caption_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:padding="16dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/km_attachment_screen_background"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/km_preview_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/km_attachment_caption_background"
                android:hint="@string/Add_caption"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/km_attachment_caption_text"
                android:textColorHint="@color/km_attachment_caption_hint"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/km_preview_cancel_btn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/km_attachment_cancel_button_background"
                    android:elevation="2dp"
                    android:text="@string/cancel_text"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/km_preview_send_btn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/km_attachment_send_button_background"
                    android:drawableStart="@drawable/km_attachment_ic_send"
                    android:drawablePadding="8dp"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:text="@string/send_text"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
