<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/idRootLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/km_attachment_screen_background"
    android:orientation="vertical"
    android:padding="16dp">

    <include
        android:id="@+id/attachment_grid_View"
        layout="@layout/attachment_gridview_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/attachment_action_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/attachment_cancel_btn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/km_attachment_cancel_button_background"
                android:elevation="2dp"
                android:text="@string/cancel_text"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/attachment_send_btn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/km_attachment_send_button_background"
                android:drawableStart="@drawable/km_attachment_ic_send"
                android:drawablePadding="8dp"
                android:elevation="2dp"
                android:gravity="center"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:text="@string/send_text"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
